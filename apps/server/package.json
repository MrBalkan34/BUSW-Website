{
  "name": "busw-account-server",
  "private": true,
  "version": "0.0.0",
  "description": "Balkan Universal Account server: shared identity, BUSW authorization, projects, submissions and administration.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx src/cli/migrate.ts",
    "find-user": "node --env-file-if-exists=.env --import tsx src/cli/find-user.ts",
    "bootstrap-owner": "node --env-file-if-exists=.env --import tsx src/cli/bootstrap-owner.ts",
    "import-legacy": "node --env-file-if-exists=.env --import tsx src/cli/import-legacy.ts",
    "seed:dev": "node --env-file-if-exists=.env --import tsx src/cli/seed-dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backup": "node --env-file-if-exists=.env --import tsx src/cli/backup.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-auth": "^1.7.14",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "nodemailer": "^10.2.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
