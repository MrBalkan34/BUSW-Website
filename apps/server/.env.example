# Balkan Universal Account server: copy to .env (never commit .env). Every value here is an example.

# --- Required in production -------------------------------------------------
NODE_ENV=production
# The public origin of the app AND the API (one origin: the server also serves the web app). https only in production.
APP_ORIGIN=https://account.busoftwareworks.com
# At least 32 random characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# Real email delivery. Verification, recovery and email-change messages depend on it.
EMAIL_TRANSPORT=smtp
SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
EMAIL_FROM="Balkan Universal Account <no-reply@busoftwareworks.com>"

# --- Optional ---------------------------------------------------------------
# Where the database and private images live. Back this folder up; it holds every account.
DATA_DIR=./data
PORT=8787
# The marketing site (and any other site allowed to read the small "who is signed in" summary), comma-separated origins.
TRUSTED_ORIGINS=https://www.busoftwareworks.com
# Announce new submissions to this address (a link, never the content).
STAFF_NOTIFY_TO=
# Links shown on the registration page. Leave empty until those pages exist; nothing is invented in the meantime.
PRIVACY_URL=
TERMS_URL=
# Seconds a sign-in counts as "recent" for privilege changes and email changes.
REAUTH_WINDOW_SECONDS=900
# Only behind a proxy you control that sets X-Forwarded-For.
TRUST_PROXY=false

# --- Development only (the server refuses these in production) --------------
# NODE_ENV=development
# EMAIL_TRANSPORT=dev-outbox   # writes mail to data/outbox and shows it at /dev/outbox
# APP_ORIGIN=http://localhost:5174
